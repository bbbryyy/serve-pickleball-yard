# Supabase project (local defaults come from `supabase status -o env`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Dink AI assistant (server-only; never NEXT_PUBLIC_)
# Provider: "anthropic" (Claude, default) or "openai" (any OpenAI-compatible endpoint, the backup).
AGENT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Backup provider (only used when AGENT_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Model: leave empty for the default (claude-haiku-5-5 for Claude, gpt-4o-mini for OpenAI)
AGENT_MODEL=
# false hides Dink and the API returns 503 (kill switch)
AGENT_ENABLED=true
# random string used to hash visitor IPs for rate limiting
AGENT_IP_SALT=
# max Dink conversations per 24 hours, across all visitors
AGENT_DAILY_LIMIT=500
